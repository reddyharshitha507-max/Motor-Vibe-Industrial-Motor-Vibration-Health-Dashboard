{
  "name": "motorvibe-co-fullstack",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:setup": "npm run db:setup -w server",
    "db:seed": "npm run db:seed -w server"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}